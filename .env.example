# Copy to .env (git-ignored). Everything is optional.

# Where the API and scripts find the database. Default matches docker-compose.
DATABASE_URL=postgresql+psycopg://tidestep:tidestep@localhost:5432/tidestep

# Where data/ lives (DEM, streets, segments, hazard). Default: ./data
# TIDESTEP_DATA=data

# Email alerts from scripts/hourly_update.py. Leave unset and alerts are
# printed to the log instead of sent.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=an-app-password
# SMTP_FROM=you@gmail.com
